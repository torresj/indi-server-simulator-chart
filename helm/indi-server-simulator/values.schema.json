{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] },
        "tag": { "type": "string" }
      }
    },
    "imagePullSecrets": { "type": "string" },
    "simulators": {
      "description": "Simulators to start. Each key maps to a driver in templates/_helpers.tpl.",
      "type": "object",
      "properties": {
        "telescope": { "type": "boolean" },
        "ccd": { "type": "boolean" },
        "focuser": { "type": "boolean" },
        "filterWheel": { "type": "boolean" },
        "guider": { "type": "boolean" },
        "rotator": { "type": "boolean" },
        "dome": { "type": "boolean" },
        "rollOffRoof": { "type": "boolean" },
        "gps": { "type": "boolean" },
        "weather": { "type": "boolean" },
        "lightPanel": { "type": "boolean" },
        "dustCover": { "type": "boolean" },
        "io": { "type": "boolean" },
        "receiver": { "type": "boolean" },
        "sqm": { "type": "boolean" },
        "alignmentCorrection": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "extraDrivers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "server": {
      "type": "object",
      "properties": {
        "verbose": { "type": "integer", "minimum": 0, "maximum": 3 },
        "maxQueueMB": { "type": "integer", "minimum": 1 },
        "maxRestarts": { "type": "integer", "minimum": 0 },
        "extraArgs": { "type": "array", "items": { "type": ["string", "number"] } }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "publicEndpoint": {
      "type": "object",
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    }
  }
}
